        }
      }
    },
    "You can't undo this action.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        }
      }
    },
    "Your library is empty: add images (PNG, ICNS, JPEG, HEIC, and more) to use them as icons.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide : ajoutez des images (PNG, ICNS, JPEG, HEIC, etc.) pour les utiliser comme icônes."
          }
        }
      }
    },
    "Your own icons, kept for your account only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres icônes, conservées uniquement pour votre compte."
          }
        }
      }
    },
    "bytes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "octets"
          }
        }
      }
    },
    "macOS only shows the Trash to apps with Full Disk Access, and only you can turn it on.\nOpen the setting and turn on Explorer. If it isn't in the list, drag Explorer there from the window that opens next to it. Then choose Quit & Reopen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'affiche la corbeille qu'aux applications disposant d'un accès complet au disque, et vous êtes le seul à pouvoir l'activer.\nOuvrez le réglage et activez Explorer. S'il n'est pas dans la liste, faites-le glisser depuis la fenêtre qui s'ouvre à côté. Choisissez ensuite Quitter et rouvrir."
          }
        }
      }
    },
    "“%@” couldn't be deleted.\n%@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'a pas pu être supprimé.\n%@"
          }
        }
      }
    }
